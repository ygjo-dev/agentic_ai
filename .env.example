# 이 기계가 무엇에 붙나. 복사해서 .env 로 쓴다 — .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 여기 있는 것은 **기계마다 다른 값**뿐이다. 모델마다 다른 값(provider ·
# num_ctx · timeout · reason 길이 상한)은 models.yaml 에 있다 — 측정으로 얻은
# 값이라 저장소에 남아야 한다.
#
# 아래 값은 전부 코드에 기본값이 있다. 기본값과 같으면 안 적어도 된다.

# LLM 이 어디 있나. 어느 모델이 어느 쪽에 붙는지는 models.yaml 의 provider 가 안다
OLLAMA_HOST=http://localhost:11434
VLLM_HOST=http://127.0.0.1:18000

# 기본 모델. 비워두면 models.yaml 의 default 를 쓴다
# LLM_MODEL=qwen3:32b

# MCP Gateway. vendor 실행기와 dev/tools 의 probe 가 부른다
GATEWAY_URL=http://localhost:3000

# 백엔드가 뜨는 자리
API_HOST=0.0.0.0
API_PORT=8000

# 화면과 측정 도구가 백엔드를 부르는 주소
BACKEND_URL=http://localhost:8000

# 개발 중에만 1. 시연에서는 0
DEMO_DEBUG=0
