# 이 기계가 무엇에 붙나. 복사해서 .env 로 쓴다 — .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 모델마다 다른 값(num_ctx · timeout · reason 길이 상한)은 여기가 아니라
# models.yaml 에 있다. 측정으로 얻은 값이라 저장소에 남아야 한다.

# LLM 이 어디 있나
OLLAMA_HOST=http://localhost:11434

# 기본 모델. 비워두면 models.yaml 의 default 를 쓴다
# OLLAMA_MODEL=qwen3:8b

# 백엔드가 뜨는 자리
API_HOST=0.0.0.0
API_PORT=8000

# 화면과 측정 도구가 백엔드를 부르는 주소
BACKEND_URL=http://localhost:8000

# 개발 중에만 1. 시연에서는 0
DEMO_DEBUG=0
