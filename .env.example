# 이 배포가 무엇에 붙나. 복사해서 .env 로 쓴다 — .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#   그리고 아래 주소 넷을 채운다. 비어 있으면 그 서비스를 부를 때 멈춘다.
#
# 여기 있는 것은 **배포마다 다른 값**뿐이다. 역할마다 다른 값(모델 · provider ·
# num_ctx · timeout · prompt · response schema 판)은 llm_engine/roles/ 에 있다 —
# 측정으로 얻은 값이라 저장소에 남아야 한다. 어느 모델로 부를지도 여기서 못 바꾼다.
#
# **주소에 기본값이 없다.** 안 적으면 localhost 로 돌아가지 않고 그 자리에서
# 멈춘다. 조용히 loopback 을 부르면 서비스를 다른 기계로 나눠 놓았을 때
# 「왜 옆 기계 것이 안 보이나」를 아무도 못 찾는다.
#
# **여기에 서버가 귀를 열 주소는 없다.** 어느 인터페이스의 몇 번 포트에 뜨는가는
# 띄우는 명령이 정한다.
#
#   uvicorn app.api.main:app --host 0.0.0.0 --port 8000
#
# 그 0.0.0.0 은 bind 주소이고, 아래 AGENTIC_API_URL 은 부르는 쪽이 찾아갈
# 주소다. 둘은 뜻이 다르므로 한 값으로 합치지 않는다.
#
# 주소는 scheme 부터 전부 적는다 (http://<host>:<port>).
# localhost · 127.x · ::1 · 0.0.0.0 은 받지 않는다.

# agentic_ai -> Ollama
# 어느 역할이 어느 쪽에 붙는지는 llm_engine/roles/<역할>/<역할>.yaml 의 model.provider 가 안다
OLLAMA_URL=

# agentic_ai -> vLLM
VLLM_URL=

# agentic_ai -> KRRI_ASAP Gateway
# vendor 실행기(mcp_client)와 dev/tools 의 계기판이 부른다
ASAP_GATEWAY_URL=

# 화면(Streamlit) · dev/tools -> agentic_ai API
# 화면은 이 주소 하나로만 백엔드를 안다. 언제든 다른 기계로 나갈 수 있다
AGENTIC_API_URL=

# 개발 중에만 1. 시연에서는 0
DEMO_DEBUG=0
